# Copy to .env and change every value marked CHANGE before anything beyond local testing.
# .env is git-ignored; never commit it.

POSTGRES_PASSWORD=postgres-admin-CHANGE
ROUTER_DB_PASSWORD=router-CHANGE
MLFLOW_DB_PASSWORD=mlflow-CHANGE
AIRFLOW_DB_PASSWORD=airflow-CHANGE

# API key callers send in X-API-Key; the router only stores its SHA-256.
# Make a hash with:  printf 'your-key' | shasum -a 256
# Default below is the hash of "dev-key-change-me".
ROUTER_API_KEY_SHA256=57c8139db7290a9064aa57837c951138a32df40cca3aca526319f55651368823
ROUTER_HASH_KEY=hmac-key-CHANGE

# Juniors: the mock server by default. For real models (Ollama running natively on the Mac):
#   JUNIOR1_URL=http://host.docker.internal:11434  JUNIOR1_MODEL=<tag chosen in Experiment 1>
JUNIOR1_URL=http://mock-models:9100
JUNIOR1_MODEL=junior-a
JUNIOR2_URL=http://mock-models:9100
JUNIOR2_MODEL=junior-b

# Senior: the mock provider by default (tests, S1-S3). For the real senior (ADR-14, interface I4):
#   SENIOR_PROVIDER=anthropic
#   SENIOR_URL=https://api.anthropic.com/v1/messages
#   SENIOR_MODEL=claude-opus-5-5
#   SENIOR_PRICE_IN=4        # USD per million input tokens (pricing page, checked 10 Nov 2026)
#   SENIOR_PRICE_OUT=20      # USD per million output tokens; thinking tokens are billed as output
#   SENIOR_API_KEY=<your key from the Claude Console; never commit it>
SENIOR_PROVIDER=mock
SENIOR_EFFORT=low
SENIOR_THINKING_HEADROOM=1024
SENIOR_URL=http://mock-models:9100/senior/v1/chat
SENIOR_MODEL=senior-mock
SENIOR_API_KEY=not-needed-for-mock
SPEND_CAP_USD=30

BREAKER_COOLDOWN_S=60
JUNIOR_CONCURRENCY_CAP=4
